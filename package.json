{
  "name": "the-cheers",
  "version": "1.0.0",
  "description": "The Cheers \u2014 rate, map and remember every espresso martini. Offline-first PWA, no build step.",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node scripts/serve.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "e2e": "node tests/e2e.smoke.js && node tests/e2e.groups.js",
    "icons": "node scripts/make-icons.js",
    "e2e:groups": "node tests/e2e.groups.js"
  },
  "engines": {
    "node": ">=18"
  }
}
